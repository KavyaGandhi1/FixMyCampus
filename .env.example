# ==============================================================================
# FixMyCampus - Environment Variables Reference (.env.example)
# ==============================================================================
# In production on Vercel: Set these in Project Settings -> Environment Variables.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Database Configuration (Backend / Vercel Serverless Function)
# ------------------------------------------------------------------------------
# Node runtime environment (development, test, production)
NODE_ENV=production

# MongoDB Atlas connection string (Standard SRV format)
# Note: In MongoDB Atlas -> Network Access, ensure 0.0.0.0/0 is whitelisted for Vercel.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fixmycampus?retryWrites=true&w=majority

# Secret key used for signing and verifying JWT tokens (Use a strong 64+ char random string)
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters_random

# JWT expiration duration
JWT_EXPIRES_IN=7d

# Production URL of your Frontend client (used for CORS and invitation URLs)
# E.g.: https://your-project.vercel.app
FRONTEND_URL=https://your-app.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Port for standalone local execution (Ignored by Vercel serverless)
PORT=5000

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Client / Vite)
# ------------------------------------------------------------------------------
# API Base URL for the frontend.
# - If Frontend & Backend are deployed together in one Vercel project, leave empty or set to /api.
# - If deployed as separate projects, set to your backend deployment URL with /api:
#   e.g. VITE_API_BASE_URL=https://your-backend.vercel.app/api
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 3. Optional Object Storage (Cloudinary - For Issue Photo Attachments)
# ------------------------------------------------------------------------------
# If left blank, images are automatically processed as secure memory buffers / base64 URIs.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. Optional SMTP Email Service (For Outbound Staff Invitation Delivery)
# ------------------------------------------------------------------------------
# If not configured, staff invitations are securely displayed directly to the Admin
# in the Staff Management dashboard with a 1-click copyable activation link.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="FixMyCampus Support <support@yourcampus.edu>"
